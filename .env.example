# Ona environment template.
# Copy to .env.local and fill in real values. NEVER commit real keys (.env.local is gitignored).
# Names only: every variable below is read somewhere in src/, scripts/ or tools/.
# Platform-provided variables (NODE_ENV, VERCEL_*, PORT) are intentionally not listed.
# Production values live in Vercel > Project > Settings > Environment Variables (see docs/HANDOFF_KEYS.md).

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side copies / service role (server only, never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional aliases the code also accepts:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_KEY=

# Direct Postgres access (db:apply, db:setup, seed scripts, server queries)
DATABASE_URL=
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
# POSTGRES_PASSWORD=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_APP_VERSION=
# Optional: proxy /api/* to another deployment (leave unset locally)
# USE_API_PROXY=false
# API_PROXY_TARGET=

# ── Maps ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_USE_LIVE_MAPS=true
# Server-side Distance Matrix / geocode key (if different from the browser key)
# GOOGLE_MAPS_API_KEY=

# ── Payments (Flutterwave default) ───────────────────────────────────────────
PAYMENT_PROVIDER=flutterwave
# Match Flutterwave v3 Dashboard → Webhooks secret hash; dedicated to notifications.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SPLIT_ENABLED=false
# FLUTTERWAVE_PLATFORM_SUBACCOUNT=
# FLUTTERWAVE_FORCE_NGN=
# NEXT_PUBLIC_FORCE_NGN=
# Static-IP payout proxy (Flutterwave Transfer API needs a whitelisted IP; see tools/flw-payout-proxy)
# FLUTTERWAVE_TRANSFER_PROXY_URL=
# FLUTTERWAVE_TRANSFER_PROXY_SECRET=
# FLUTTERWAVE_EGRESS_IPS=
# Local/dev only: allow the mock checkout provider. Never enable in production.
# ALLOW_MOCK_PAYMENTS=false
# PAYSTACK_SECRET_KEY=

# ── Cron / scheduled jobs (any one of the matching secrets authorises the call) ──
CRON_SECRET=
# Optional base origin for the portable deadline scheduler client (HTTPS hosted or local port 3100).
# DEADLINE_SWEEP_BASE_URL=http://localhost:3100
# ONA_CRON_SECRET=
# JOB_EXPIRE_SECRET=
# ALLOW_OPEN_PAYOUT_CRON=false

# ── Admin / Care desk ────────────────────────────────────────────────────────
# Required: also used to derive the field-encryption salt. Set a strong unique value.
ADMIN_SENSITIVE_PASSWORD=
# ADMIN_FIELD_ENCRYPTION_KEY=
# ADMIN_SESSION_SIGNING_SECRET=
# ADMIN_UNLOCK_SIGNING_SECRET=
# Seed account for `npm run db:seed-admin`
# Required for `npm run db:setup` / `db:seed-admin` (the Super Admin you will log in with):
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
# ADMIN_SEED_NAME=
# Optional: use an existing Auth user's id instead of creating one (otherwise db:setup finds or creates it by email)
# ADMIN_AUTH_USER_ID=

# ── OTP / SMS / email ────────────────────────────────────────────────────────
# SECURITY: the demo OTP code is accepted in production UNLESS BOTH of these are exactly "false".
# Set both to false once real SMS (Africa's Talking) is live.
OTP_DEMO_MODE=true
NEXT_PUBLIC_OTP_DEMO_MODE=true
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# ── Identity verification (optional) ─────────────────────────────────────────
# PREMBLY_API_KEY=
# PREMBLY_APP_ID=
# PREMBLY_BASE_URL=
# IDENTITYPASS_API_KEY=
# IDENTITYPASS_APP_ID=

# ── Web push (generate with: npx web-push generate-vapid-keys) ───────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ── Rate limiting / cache (optional; in-memory fallback when unset) ──────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
